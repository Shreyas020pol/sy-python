print("========== Monthly Expenditure Calculator ==========")

expenses = []
count = 0

while True:
    amount = float(input("Enter Daily Expense Amount (-1 to stop): "))

    if amount == -1:
        break

    expenses.append(amount)
    count += 1

print("\n========== Monthly Expense Report ==========")
print("Number of Expenses Recorded :", count)
print("Total Monthly Expenditure   :", sum(expenses))
print("===========================================")
